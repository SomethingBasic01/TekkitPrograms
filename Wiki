local clientScript=[=[
event load
  call local.get "wiki.localClicks" -> c
  if $c == nil
    set c 0
  endif
  call ui.setText "local" "Local counter: ${c}"
end

event lab_local
  call local.get "wiki.localClicks" -> c
  if $c == nil
    set c 0
  endif
  math c $c + 1
  call local.set "wiki.localClicks" $c
  call ui.setText "local" "Local counter: ${c}"
end
]=]

local serverScript=[=[
event lab_identity
  call user.name -> who
  if $who == nil
    call ui.setText "identity" "Identity: Guest (not logged in)"
  else
    call ui.setText "identity" "Identity: ${who}"
  endif
end

event lab_shared
  call storage.inc "labs.sharedCounter" 1 -> n
  call ui.setText "shared" "Shared counter: ${n}"
end

event lab_refresh
  call storage.get "labs.sharedCounter" -> n
  if $n == nil
    set n 0
  endif
  call ui.setText "shared" "Shared counter: ${n}"
end

event lab_mail
  call site.owner -> owner
  call mail.send $owner "Wiki Lab message" $input.demoMessage -> mid
  call ui.setText "mailState" "Sent real SpawnNet Mail: ${mid}"
  call ui.alert "Mail delivered to ${owner}"
end

event job_submit
  call jobs.submit "demo" "operation" $input.jobItem $input.jobCount -> jid
  call ui.setValue "jobId" $jid
  call ui.setProgress "jobProgress" 0
  call ui.setText "jobState" "QUEUED: ${jid} - waiting for a worker you write"
end

event job_refresh
  if $input.jobId != ""
    call jobs.status $input.jobId -> j
    if $j != nil
      call ui.setText "jobState" "${j.status}: ${j.message}"
      call ui.setProgress "jobProgress" $j.progress
    endif
  endif
end

event telemetry_refresh
  call telemetry.last "demo" -> t
  if $t == nil
    call ui.setText "telemetryState" "STREAM OFFLINE - NO REAL DATA YET"
    call ui.setText "telemetryBody" "Push wiki/demo telemetry from your own trusted Lua worker."
  else
    call ui.setText "telemetryState" "LIVE TELEMETRY - COMPUTER #${t._computer}"
    call ui.setText "telemetryBody" "Machine: ${t.machine}  Power: ${t.power}  Temperature: ${t.temperature}  Online: ${t.online}"
  endif
end

event cluster_refresh
  call network.cluster -> c
  call ui.setText "clusterState" "CLUSTER: ${c.online}/${c.totalNodes} STORAGE NODES ONLINE"
  call ui.setText "clusterFree" "Combined online free space: ${c.free} bytes"
  call ui.setText "clusterObjects" "Tracked distributed objects: ${c.objects}"
end
]=]

